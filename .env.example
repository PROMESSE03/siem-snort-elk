# URL du webhook entrant Slack (Slack > Apps > Incoming Webhooks)
# Exemple : https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REMPLACER/PAR/VOTRE_URL
